{
    "name": "pr3set-llc/silverstripe-site-tools",
    "description": "Tools to build common functionality in SilverStripe sites.",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5",
        "silverstripe/cms": "^5",
        "silvershop/silverstripe-hasonefield": "^4.0",
        "silverstripe/linkfield": "^4.0",
        "symbiote/silverstripe-gridfieldextensions": "^4",
        "unclecheese/display-logic": "^3.0"
    },
    "conflict": {
        "silverstripe/framework": "<5 || >=6"
    },
    "replace": {
        "dynamic/silverstripe-site-tools": "*"
    },
    "require-dev": {
        "dnadesign/silverstripe-elemental": "^5",
        "silverstripe/recipe-testing": "^3.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\SiteTools\\": "src/",
            "Dynamic\\SiteTools\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        },
        "process-timeout": 600
    },
    "extra": {
        "branch-alias": {
            "dev-5.x": "5.x-dev"
        }
    }
}