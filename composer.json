{
    "name": "pr3set-llc/silverstripe-site-tools",
    "description": "Tools to build common functionality in SilverStripe sites.",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "CMS"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/linkfield": "^5",
        "silvershop/silverstripe-hasonefield": "^5",
        "symbiote/silverstripe-gridfieldextensions": "^5",
        "unclecheese/display-logic": "^4"
    },
    "conflict": {
        "silverstripe/framework": "<6 || >=7"
    },
    "replace": {
        "dynamic/silverstripe-site-tools": "*"
    },
    "require-dev": {
        "dnadesign/silverstripe-elemental": "^6",
        "silverstripe/recipe-testing": "^4",
        "wernerkrauss/silverstripe-rector": "1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\SiteTools\\": "src/",
            "Dynamic\\SiteTools\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        },
        "process-timeout": 600
    },
    "extra": {
        "branch-alias": {
            "dev-6.x": "6.x-dev"
        },
        "project-files-installed": [
            "behat.yml",
            "phpunit.xml.dist"
        ]
    }
}
